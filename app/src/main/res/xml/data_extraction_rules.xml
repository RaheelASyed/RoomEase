<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Receipt photos stay on this device only: excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="receipts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="receipts/" />
    </device-transfer>
</data-extraction-rules>
